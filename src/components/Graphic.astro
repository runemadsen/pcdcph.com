---
import css from './Graphic.module.css';

interface Props {
  year: string;
}

const { year } = Astro.props;
---

{
  /*
  The viewBox gives the svg an intrinsic aspect ratio, so the browser reserves
  its height at first paint and the page never shifts. The pattern text needs
  Space Grotesk, and font-display: block holds that text back until the font
  arrives, so it is never painted in a fallback face. No script is involved.
*/
}
<svg class={css.root} viewBox="0 0 1440 400">
  <defs>
    <pattern
      id="pattern"
      x="0"
      y="100%"
      width="223"
      height="40"
      patternUnits="userSpaceOnUse"
    >
      <text x="0" y="32" font-size="32" fill="var(--processing-dark)">
        PCD CPH {year}
      </text>
    </pattern>
  </defs>
  <rect
    fill="url(#pattern)"
    width="150%"
    height="100%"
    transform="translate(-100 0) rotate(-5)"></rect>
  <line
    x1="348"
    y1="-30"
    x2="446"
    y2="173"
    stroke="var(--processing-light)"
    stroke-width="155"></line>
  <line
    x1="813"
    y1="-71"
    x2="509"
    y2="343"
    stroke="var(--processing-dark)"
    stroke-width="155"></line>
  <path
    d="M 835 -125 C 1141 -125 1141 284 835 284"
    stroke="var(--processing-mid)"
    fill="none"
    stroke-width="155"></path>
</svg>
