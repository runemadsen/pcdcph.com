---
import Layout from '../layouts/Layout.astro';

import css from '../styles/pages/index.module.css';
import grid from '../styles/grid.module.css';

import dmjx from '../images/dmjx.png';
---

<Layout
  title="Processing Community Day Copenhagen 2026"
  year="2026"
  class={css.root}
>
  <div class={css.header}>
    <div class:list={[grid.container, grid.grid]}>
      <div class:list={[grid.col, css.menu]}>
        <ul>
          <li>
            <a href="#program">Program</a>
          </li>
          <li>
            <a href="#about">About</a>
          </li>
          <li>
            <a href="#contact">Contact</a>
          </li>
        </ul>
      </div>
      <div class:list={[grid.col, css.title]}>
        <h1>Processing Community Day CPH</h1>
      </div>
      <div class:list={[grid.col, css.info]}>
        <h3>When?</h3>
        <p>
          Saturday October 24th, 2026
          <br />
          11:00 am
          <br />
          Afterparty at{' '}
          <a href="https://maps.app.goo.gl/QdaYCxa1zWh6BjtR7">Åben Brewery</a>
        </p>
        <h3>Where?</h3>
        <p>
          Danish School of Media and Journalism
          <br />
          <a href="https://maps.app.goo.gl/gVg27hSGXrWkzMTx5">DMJX Copenhagen</a
          >
        </p>
        <a
          class={css.register}
          target="_blank"
          rel="noreferrer"
          href="https://forms.gle/oN7YX6pXdhn29YgP7"
        >
          Register
        </a>
        <p class={css.disclaimer}>
          This link opens in a new window as registration for this event is
          handled through Google Forms.
        </p>
      </div>
    </div>
  </div>
  <div class:list={[grid.container, grid.grid]}>
    <div class:list={[grid.col, css.text]}>
      <h2>Presented in partnership with</h2>
      <ul class={css.partners}>
        <li>
          <a href="https://www.dmjx.dk/">
            <img src={dmjx.src} />
          </a>
          <p>Danish School of Media and Journalism</p>
        </li>
      </ul>
    </div>
    <div class:list={[grid.col, css.text]} id="program">
      <h2>Program</h2>
      <p>Program coming soon</p>
    </div>
    <div class:list={[grid.col, css.text]} id="about">
      <h2>About the Event</h2>
      <p>
        Processing Community Day Copenhagen is a free, one-day event to
        celebrate the intersection of design, art, and code. The day will
        consist of keynotes and lightning talks by people using code for
        creative and experimental projects. It’s a unique chance for everyone
        working with or just interested in code, design and digital art to meet
        in person, share what they're working on, learn from each other, and
        make new connections. The event is open to everyone and requires no
        prior skills or knowledge of coding. Processing Community Day is a
        welcoming place for anyone interested in learning about programming,
        including those not normally represented in the fields of engineering
        and technology.
      </p>
      <p>
        Processing is a free and open-source software platform for learning how
        to code within the context of the visual arts, created by Casey Reas and
        Ben Fry. It is complemented by a web version, called p5.js, created by
        Lauren McCarthy. To date, Processing and p5.js are used by a worldwide
        community of artists, coders, educators and students to create diverse
        art in the fields of graphic design, architecture, dance, photography,
        painting, etc. A focus of the Processing Foundation is to make learning
        how to program and make creative work with code accessible to diverse
        communities, especially those who might not otherwise have access to
        these tools and resources.
      </p>
    </div>
    <div class:list={[grid.col, css.text]} id="contact">
      <h2>Contact</h2>
      <p>
        Processing Community Day Copenhagen is organized by{' '}
        <a href="https://andreasrefsgaard.dk/">Andreas Refsgaard</a>,{' '}
        <a href="http://www.stigmollerhansen.dk/">Stig Møller Hansen</a>, and{
          ' '
        }
        <a href="https://runemadsen.com/">Rune Madsen</a>. You can get in touch
        with us on{' '}
        <a href="mailto:organizer@pcdcph.com">organizer@pcdcph.com</a>.
      </p>
    </div>
  </div>
</Layout>
