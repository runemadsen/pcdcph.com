---
import 'sanitize.css';
import '../styles/fonts.css';
import '../styles/variables.css';
import '../styles/base.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta property="og:title" content="Processing Community Day Copenhagen" />
    <meta property="og:image" content="https://pcdcph.com/share.png" />
    {
      /*
      The fonts are self-hosted so they start downloading with the HTML,
      rather than after a stylesheet from a second origin. crossorigin is
      required on a font preload even when the file is same-origin, because
      fonts are always fetched in CORS mode. Only the latin subsets are
      preloaded, since they cover every character on the site.
    */
    }
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <script
      src="https://cdn.usefathom.com/script.js"
      data-spa="auto"
      data-site="RMGIDAGX"
      defer
      is:inline></script>
  </head>
  <body>
    <slot />
  </body>
</html>
