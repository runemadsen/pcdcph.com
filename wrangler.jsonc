{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcdcph",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "pcdcph.com",
      "custom_domain": true
    },
    {
      "pattern": "www.pcdcph.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
